<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : botName %> — Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
           background: #0f0f13; color: #e2e8f0; min-height: 100vh; }
    a { color: #a78bfa; text-decoration: none; }
    a:hover { color: #c4b5fd; }

    /* Layout */
    .layout { display: flex; min-height: 100vh; }
    .sidebar { width: 220px; background: #1a1a2e; padding: 24px 0; flex-shrink: 0;
               border-right: 1px solid #2d2d44; }
    .main { flex: 1; padding: 32px; overflow-y: auto; }

    /* Sidebar */
    .sidebar-brand { padding: 0 20px 24px; font-size: 18px; font-weight: 700;
                     color: #a78bfa; border-bottom: 1px solid #2d2d44; margin-bottom: 16px; }
    .sidebar-nav a { display: flex; align-items: center; gap: 10px; padding: 10px 20px;
                     color: #94a3b8; font-size: 14px; transition: all 0.15s; }
    .sidebar-nav a:hover, .sidebar-nav a.active { background: #2d2d44; color: #e2e8f0; }
    .sidebar-nav .icon { width: 18px; text-align: center; }

    /* Cards */
    .card { background: #1a1a2e; border: 1px solid #2d2d44; border-radius: 10px;
            padding: 20px; margin-bottom: 20px; }
    .card-title { font-size: 13px; color: #64748b; text-transform: uppercase;
                  letter-spacing: 0.05em; margin-bottom: 8px; }
    .card-value { font-size: 32px; font-weight: 700; color: #e2e8f0; }
    .card-sub { font-size: 13px; color: #64748b; margin-top: 4px; }

    /* Grid */
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    @media (max-width: 1100px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 700px)  { .grid-4, .grid-2 { grid-template-columns: 1fr; } }

    /* Tables */
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th { text-align: left; padding: 10px 12px; color: #64748b; font-size: 12px;
         text-transform: uppercase; border-bottom: 1px solid #2d2d44; }
    td { padding: 10px 12px; border-bottom: 1px solid #1e2030; vertical-align: middle; }
    tr:hover td { background: #1e2030; }

    /* Badges */
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px;
             font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .badge-premium { background: #7c3aed22; color: #a78bfa; }
    .badge-free    { background: #1e293b;   color: #64748b; }
    .badge-active  { background: #05966922; color: #34d399; }
    .badge-expired { background: #dc262622; color: #f87171; }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
           border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer;
           border: none; transition: all 0.15s; }
    .btn-primary { background: #7c3aed; color: white; }
    .btn-primary:hover { background: #6d28d9; color: white; }
    .btn-danger  { background: #dc2626; color: white; }
    .btn-danger:hover { background: #b91c1c; color: white; }
    .btn-ghost   { background: transparent; color: #94a3b8; border: 1px solid #2d2d44; }
    .btn-ghost:hover { background: #2d2d44; color: #e2e8f0; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }

    /* Forms */
    .form-group { margin-bottom: 16px; }
    label { display: block; font-size: 13px; color: #94a3b8; margin-bottom: 6px; }
    input[type=text], input[type=password], input[type=number],
    select, textarea {
      width: 100%; background: #0f0f13; border: 1px solid #2d2d44;
      color: #e2e8f0; padding: 9px 12px; border-radius: 6px; font-size: 14px;
    }
    input:focus, select:focus, textarea:focus {
      outline: none; border-color: #7c3aed;
    }

    /* Alerts */
    .alert { padding: 12px 16px; border-radius: 6px; font-size: 14px; margin-bottom: 16px; }
    .alert-error   { background: #dc262622; border: 1px solid #dc2626; color: #f87171; }
    .alert-success { background: #05966922; border: 1px solid #059669; color: #34d399; }

    /* Page header */
    .page-header { margin-bottom: 28px; }
    .page-header h1 { font-size: 24px; font-weight: 700; }
    .page-header p  { color: #64748b; font-size: 14px; margin-top: 4px; }

    /* Misc */
    .text-muted  { color: #64748b; font-size: 13px; }
    .text-green  { color: #34d399; }
    .text-red    { color: #f87171; }
    .text-purple { color: #a78bfa; }
    .mt-16 { margin-top: 16px; }
    .flex  { display: flex; align-items: center; gap: 8px; }
    .maintenance-banner { background: #dc262622; border: 1px solid #dc2626;
                          color: #f87171; padding: 10px 16px; border-radius: 6px;
                          margin-bottom: 20px; font-size: 14px; }
  </style>
</head>
<body>
