<%- include('../partials/head', { title: 'Users' }) %>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1>Users</h1>
      <p><%= total.toLocaleString() %> total users</p>
    </div>

    <!-- Search & filter -->
    <div class="card" style="margin-bottom:20px;">
      <form method="GET" action="/admin/users" style="display:flex; gap:12px; flex-wrap:wrap;">
        <input type="text" name="search" placeholder="Search by name, username, or Telegram ID"
               value="<%= search %>" style="flex:1; min-width:200px;">
        <select name="plan" style="width:140px;">
          <option value="">All plans</option>
          <option value="free"    <%= planFilter === 'free'    ? 'selected' : '' %>>Free</option>
          <option value="premium" <%= planFilter === 'premium' ? 'selected' : '' %>>Premium</option>
        </select>
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="/admin/users" class="btn btn-ghost">Clear</a>
      </form>
    </div>

    <div class="card">
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Telegram ID</th>
            <th>Plan</th>
            <th>Stats</th>
            <th>Joined</th>
            <th>Last Active</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <strong><%= u.firstName || '' %> <%= u.lastName || '' %></strong>
                <% if (u.username) { %><br><span class="text-muted">@<%= u.username %></span><% } %>
                <% if (u.customFreeMessages !== null || u.customFreeImages !== null) { %>
                  <div style="font-size: 11px; margin-top: 4px; color: #a78bfa;">
                    Custom limits: ✉️ <%= u.customFreeMessages !== null ? u.customFreeMessages : 'Default' %> | 🖼️ <%= u.customFreeImages !== null ? u.customFreeImages : 'Default' %>
                  </div>
                <% } %>
              </td>
              <td class="text-muted"><%= u.telegramId %></td>
              <td>
                <span class="badge <%= u.plan === 'premium' ? 'badge-premium' : 'badge-free' %>">
                  <%= u.plan %>
                </span>
              </td>
              <td>
                💬 <b><%= u.stats?.totalMessages || 0 %></b> msgs<br>
                🖼️ <b><%= u.stats?.totalImages || 0 %></b> imgs
              </td>
              <td class="text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              <td class="text-muted">
                <%= u.stats?.lastActiveAt ? new Date(u.stats.lastActiveAt).toLocaleDateString() : '—' %>
              </td>
              <td>
                <% if (u.isBanned) { %>
                  <span class="badge badge-expired">Banned</span>
                <% } else { %>
                  <span class="badge badge-active">Active</span>
                <% } %>
              </td>
              <td>
                <button class="btn btn-ghost btn-sm btn-credits" style="margin-right: 4px;"
                        data-telegram-id="<%= u.telegramId %>"
                        data-name="<%= u.firstName || u.username || u.telegramId %>"
                        data-messages="<%= u.customFreeMessages !== null ? u.customFreeMessages : '' %>"
                        data-images="<%= u.customFreeImages !== null ? u.customFreeImages : '' %>"
                        onclick="handleCreditsClick(this)">
                  Credits
                </button>
                <button class="btn btn-ghost btn-sm" style="margin-right: 4px;"
                        onclick="showChatHistory('<%= u.telegramId %>', '<%= u.firstName || u.username || u.telegramId %>')">
                  💬 Chat
                </button>
                <% if (u.isBanned) { %>
                  <button class="btn btn-ghost btn-sm"
                          onclick="adminAction('/admin/users/unban', { telegramId: '<%= u.telegramId %>' })">
                    Unban
                  </button>
                <% } else { %>
                  <button class="btn btn-danger btn-sm"
                          onclick="adminAction('/admin/users/ban', { telegramId: '<%= u.telegramId %>', reason: 'Admin action' })">
                    Ban
                  </button>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (users.length === 0) { %>
            <tr><td colspan="8" class="text-muted" style="text-align:center; padding:32px;">No users found.</td></tr>
          <% } %>
        </tbody>
      </table>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="display:flex; gap:8px; justify-content:center; margin-top:20px;">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/admin/users?page=<%= i %>&search=<%= search %>&plan=<%= planFilter %>"
               class="btn <%= i === currentPage ? 'btn-primary' : 'btn-ghost' %> btn-sm">
              <%= i %>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<div id="credits-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); align-items:center; justify-content:center; z-index:1000;">
  <div class="card" style="width:100%; max-width:400px; padding:24px; position:relative; background:#1a1a2e; border:1px solid #2d2d44; border-radius:10px;">
    <h3 style="margin-bottom:16px; color:#a78bfa;">Edit Credits Override</h3>
    <p id="credits-modal-user" style="font-size:13px; color:#94a3b8; margin-bottom:20px;"></p>
    
    <input type="hidden" id="credits-modal-telegramId">
    
    <div class="form-group">
      <label for="credits-modal-messages">Custom Daily Messages Limit</label>
      <input type="number" id="credits-modal-messages" placeholder="Use Default limit">
      <small style="color:#64748b; font-size:11px;">Leave empty or clear to use the default plan limit.</small>
    </div>
    
    <div class="form-group" style="margin-top:12px;">
      <label for="credits-modal-images">Custom Daily Images Limit</label>
      <input type="number" id="credits-modal-images" placeholder="Use Default limit">
      <small style="color:#64748b; font-size:11px;">Leave empty or clear to use the default plan limit.</small>
    </div>
    
    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:24px;">
      <button class="btn btn-ghost" onclick="closeCreditsModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveCreditsOverride()">Save Changes</button>
    </div>
  </div>
</div>

<div id="chat-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); align-items:center; justify-content:center; z-index:1000;">
  <div class="card" style="width:100%; max-width:600px; height:80%; display:flex; flex-direction:column; padding:24px; position:relative; background:#1a1a2e; border:1px solid #2d2d44; border-radius:10px;">
    <h3 style="margin-bottom:8px; color:#a78bfa;" id="chat-modal-title">Chat Log</h3>
    <p id="chat-modal-subtitle" style="font-size:12px; color:#94a3b8; margin-bottom:16px;"></p>
    
    <div id="chat-modal-body" style="flex:1; overflow-y:auto; background:#111122; border:1px solid #2d2d44; padding:16px; border-radius:6px; display:flex; flex-direction:column; gap:12px; margin-bottom:16px;">
      <!-- Message bubbles injected here -->
    </div>
    
    <div style="display:flex; justify-content:flex-end;">
      <button class="btn btn-ghost" onclick="closeChatModal()">Close</button>
    </div>
  </div>
</div>

<div id="toast" style="display:none; position:fixed; bottom:24px; right:24px;
     background:#1a1a2e; border:1px solid #2d2d44; padding:12px 20px;
     border-radius:8px; font-size:14px; z-index:9999;"></div>

<script>
async function showChatHistory(telegramId, name) {
  document.getElementById('chat-modal-title').textContent = 'Chat Log: ' + name;
  document.getElementById('chat-modal-subtitle').textContent = 'Telegram ID: ' + telegramId;
  const container = document.getElementById('chat-modal-body');
  container.innerHTML = '<p class="text-muted" style="text-align:center;">Loading messages...</p>';
  document.getElementById('chat-modal').style.display = 'flex';
  
  try {
    const res = await fetch(`/admin/users/${telegramId}/messages`);
    const data = await res.json();
    if (data.status === 'ok') {
      if (data.messages.length === 0) {
        container.innerHTML = '<p class="text-muted" style="text-align:center;">No messages found in history.</p>';
      } else {
        container.innerHTML = '';
        data.messages.forEach(m => {
          const bubble = document.createElement('div');
          const isUser = m.role === 'user';
          bubble.style.maxWidth = '85%';
          bubble.style.padding = '10px 14px';
          bubble.style.borderRadius = '8px';
          bubble.style.fontSize = '13px';
          bubble.style.lineHeight = '1.4';
          bubble.style.wordBreak = 'break-word';
          
          if (isUser) {
            bubble.style.alignSelf = 'flex-end';
            bubble.style.background = '#4c1d95'; // Purple bubble for user
            bubble.style.color = '#f5f3ff';
          } else {
            bubble.style.alignSelf = 'flex-start';
            bubble.style.background = '#1e293b'; // Slate bubble for bot
            bubble.style.color = '#f1f5f9';
          }
          
          const label = document.createElement('div');
          label.style.fontWeight = 'bold';
          label.style.fontSize = '10px';
          label.style.marginBottom = '4px';
          label.style.color = isUser ? '#c084fc' : '#94a3b8';
          label.textContent = isUser ? 'USER' : 'ASSISTANT';
          
          const text = document.createElement('div');
          text.textContent = m.content;
          
          const time = document.createElement('div');
          time.style.fontSize = '9px';
          time.style.color = isUser ? '#d8b4fe' : '#64748b';
          time.style.marginTop = '4px';
          time.style.textAlign = 'right';
          time.textContent = new Date(m.createdAt).toLocaleTimeString();
          
          bubble.appendChild(label);
          bubble.appendChild(text);
          bubble.appendChild(time);
          container.appendChild(bubble);
        });
        // Scroll to bottom
        container.scrollTop = container.scrollHeight;
      }
    } else {
      container.innerHTML = '<p style="color:#f87171; text-align:center;">Error: ' + (data.message || 'Failed to load messages') + '</p>';
    }
  } catch (err) {
    container.innerHTML = '<p style="color:#f87171; text-align:center;">Request failed</p>';
  }
}

function closeChatModal() {
  document.getElementById('chat-modal').style.display = 'none';
}
async function adminAction(url, body) {
  if (!confirm('Are you sure?')) return;
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-Admin-Key': '' }, // optionally pass key
      body: JSON.stringify(body),
    });
    const data = await res.json();
    showToast(data.message || 'Done', data.status === 'ok');
    if (data.status === 'ok') setTimeout(() => location.reload(), 1200);
  } catch (e) {
    showToast('Request failed', false);
  }
}

function handleCreditsClick(btn) {
  const telegramId = btn.getAttribute('data-telegram-id');
  const name = btn.getAttribute('data-name');
  const messages = btn.getAttribute('data-messages');
  const images = btn.getAttribute('data-images');
  openCreditsModal(telegramId, name, messages, images);
}

function openCreditsModal(telegramId, name, currentMessages, currentImages) {
  document.getElementById('credits-modal-telegramId').value = telegramId;
  document.getElementById('credits-modal-user').textContent = 'User: ' + name + ' (ID: ' + telegramId + ')';
  document.getElementById('credits-modal-messages').value = currentMessages;
  document.getElementById('credits-modal-images').value = currentImages;
  document.getElementById('credits-modal').style.display = 'flex';
}

function closeCreditsModal() {
  document.getElementById('credits-modal').style.display = 'none';
}

async function saveCreditsOverride() {
  const telegramId = document.getElementById('credits-modal-telegramId').value;
  const customFreeMessages = document.getElementById('credits-modal-messages').value;
  const customFreeImages = document.getElementById('credits-modal-images').value;
  
  try {
    const res = await fetch('/admin/users/update-credits', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'X-Admin-Key': '' 
      },
      body: JSON.stringify({ telegramId, customFreeMessages, customFreeImages }),
    });
    const data = await res.json();
    showToast(data.message || 'Done', data.status === 'ok');
    closeCreditsModal();
    if (data.status === 'ok') setTimeout(() => location.reload(), 1200);
  } catch (e) {
    showToast('Failed to update credits', false);
  }
}

function showToast(msg, ok) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  t.style.borderColor = ok ? '#059669' : '#dc2626';
  t.style.color = ok ? '#34d399' : '#f87171';
  setTimeout(() => { t.style.display = 'none'; }, 3000);
}
</script>
</body></html>
