# =============================================================================
# Telegram AI Companion — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED.
# Values marked DEFAULT are optional — the app will use the shown default.
# NEVER commit your real .env file to version control.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=3000                       # DEFAULT: 3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use MongoDB Atlas free tier for managed hosting (recommended)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=                    # REQUIRED

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1            # DEFAULT: 127.0.0.1
REDIS_PORT=6379                 # DEFAULT: 6379
REDIS_PASSWORD=                 # Leave empty if no password
REDIS_TLS=false                 # Set true for Redis Cloud / Upstash

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=             # REQUIRED  — format: 123456789:ABCdef...
# Random secret string (min 16 chars) — used to verify webhook requests
TELEGRAM_WEBHOOK_SECRET=        # REQUIRED  — generate: openssl rand -hex 32
# Your public server URL where Telegram will POST updates
# Format: https://yourdomain.com/webhook/<BOT_TOKEN>
TELEGRAM_WEBHOOK_URL=           # REQUIRED  — e.g. https://api.yourdomain.com

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=                 # REQUIRED  — format: sk-...
OPENAI_MODEL=gpt-4o             # DEFAULT: gpt-4o
OPENAI_MAX_TOKENS=1024          # DEFAULT: 1024
OPENAI_TEMPERATURE=0.85         # DEFAULT: 0.85

# ── Fal AI & Runware AI (Image Generation) ────────────────────────────────────
# Get Fal AI key from https://fal.ai
FAL_KEY=                        # REQUIRED
# Get Runware API key from https://runware.ai
RUNWARE_API_KEY=                # REQUIRED

# ── Sentry (Error Monitoring) ─────────────────────────────────────────────────
# Get from https://sentry.io — create a Node.js project
# Leave empty to disable Sentry
SENTRY_DSN=                     # OPTIONAL  — format: https://xxx@yyy.ingest.sentry.io/zzz

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Secret key used to authenticate admin API requests
# Generate: openssl rand -hex 32
ADMIN_SECRET_KEY=               # REQUIRED  — min 32 characters
ADMIN_USERNAME=admin            # DEFAULT: admin
ADMIN_PASSWORD=                 # REQUIRED  — min 12 characters

# ── Session Security ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=                 # REQUIRED  — min 32 characters

# ── Free Plan Limits ──────────────────────────────────────────────────────────
FREE_DAILY_MESSAGES=20          # DEFAULT: 20
FREE_DAILY_IMAGES=3             # DEFAULT: 3
FREE_MEMORY_LIMIT=20            # DEFAULT: 20  (number of memories stored)

# ── Premium Plan Limits ───────────────────────────────────────────────────────
PREMIUM_DAILY_MESSAGES=500      # DEFAULT: 500
PREMIUM_DAILY_IMAGES=20         # DEFAULT: 20
PREMIUM_MEMORY_LIMIT=200        # DEFAULT: 200

# ── Telegram Stars Pricing ────────────────────────────────────────────────────
STARS_MONTHLY_PRICE=299         # DEFAULT: 299 stars/month
STARS_WEEKLY_PRICE=99           # DEFAULT: 99  stars/week

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
BOT_NAME=Luna                   # DEFAULT: Luna
MAINTENANCE_MODE=false          # DEFAULT: false  — set true to block all users
LOG_LEVEL=info                  # DEFAULT: info   — error|warn|info|http|debug
