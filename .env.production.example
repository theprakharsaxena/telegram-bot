# =============================================================================
# PRODUCTION Environment Variables
# Copy this to .env on the EC2 server and fill in every value.
# NEVER commit the real .env file to version control.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Use the same Atlas cluster URI from your local .env
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/telegram_companion?retryWrites=true&w=majority

# ── Redis (local on EC2) ───────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                # Set a strong password — see bootstrap script
REDIS_TLS=false

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # From @BotFather — same as local
# Generate fresh: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=       # MUST match what you set when registering the webhook
# Your domain — Nginx terminates SSL, forwards to :3000
TELEGRAM_WEBHOOK_URL=https://yourdomain.com

# ── Novita AI (Chat) ──────────────────────────────────────────────────────────
# Get from https://novita.ai/settings/key-management
NOVITA_API_KEY=                # REQUIRED
NOVITA_BASE_URL=https://api.novita.ai/openai
NOVITA_MODEL=meta-llama/llama-3.1-8b-instruct
NOVITA_MAX_TOKENS=2048
NOVITA_TEMPERATURE=1

# ── Replicate ─────────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=           # Same as local
REPLICATE_IMAGE_MODEL=stability-ai/sdxl:39ed52f2319f9b4cf9d5f9b3c5b9a6c7d2e5f8a1b3c6e9f2a4b7d0e3f6a9b2c5

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=                    # Recommended for production — from sentry.io

# ── Admin ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ADMIN_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # Strong password, min 12 chars

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each: openssl rand -hex 32
SESSION_SECRET=

# ── Plan Limits ───────────────────────────────────────────────────────────────
FREE_DAILY_MESSAGES=20
FREE_DAILY_IMAGES=3
FREE_MEMORY_LIMIT=20
PREMIUM_DAILY_MESSAGES=500
PREMIUM_DAILY_IMAGES=20
PREMIUM_MEMORY_LIMIT=200

# ── Telegram Stars Pricing ────────────────────────────────────────────────────
STARS_MONTHLY_PRICE=299
STARS_WEEKLY_PRICE=99

# ── Bot ───────────────────────────────────────────────────────────────────────
BOT_NAME=Luna
MAINTENANCE_MODE=false
LOG_LEVEL=info
